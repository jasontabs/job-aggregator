# Scraped output — regenerated daily, don't track
Skills/job-scraper/output/*.json
Skills/job-ranker/output/*.json

# Keep output directories themselves
!Skills/job-scraper/output/.gitkeep
!Skills/job-ranker/output/.gitkeep

# SQLite job database — local state, not tracked
Skills/job-scraper/db/

# Daily run logs
logs/

# Claude local settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# macOS metadata
.DS_Store

# Local content not part of the agent
Product Management/
